# ===== doc-pipeline =====
PIPELINE_PORT=8000
PIPELINE_HOST=0.0.0.0

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=docagent
S3_SECRET_KEY=docagent-secret
S3_BUCKET=docagent
S3_FORCE_PATH_STYLE=true

# OpenSearch
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
OPENSEARCH_META_INDEX=docagent-meta
OPENSEARCH_BLOCKS_INDEX=docagent-blocks

# 服务间内部密钥（agent → pipeline 调用时携带）
INTERNAL_SERVICE_KEY=dev-internal-key

# ===== doc-agent =====
AGENT_PORT=8001
AGENT_HOST=0.0.0.0
# SQLite 数据与工作区持久卷目录（相对路径锚定仓库根）
AGENT_DATA_DIR=./var/agent
# skill 包根目录（目录或 ZIP 均可）
AGENT_SKILLS_DIR=./var/skills
# 前端静态目录缺省为服务自带的 services/docagent-agent/web；
# 自定义时给绝对路径，或相对仓库根的路径（如 ./services/docagent-agent/web）
# AGENT_WEB_DIR=

PIPELINE_BASE_URL=http://localhost:8000

# 内网文本模型（OpenAI 兼容端点）
MODEL_BASE_URL=http://localhost:8000
MODEL_API_KEY=
MODEL_NAME=qwen3.8-27b
MODEL_CONTEXT_WINDOW=128000

# 执行预算
MAX_RUNNING_TASKS=4
MAX_STEPS=48
MAX_TASK_WALL_MINUTES=40
MAX_TASK_TOKENS=2000000
REQUEST_INPUT_LIMIT=3
WAITING_INDEX_TIMEOUT_SECONDS=900
