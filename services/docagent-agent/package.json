{
  "name": "docagent-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DocAgent 任务服务：调度、skill 加载、模型与工具循环、补充请求与结果发布",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
