    "marked": "^18.2.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.3.1",
    "typescript": "^5.9.2",
    "vitest": "^5.1.1"
  }
}
